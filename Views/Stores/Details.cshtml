@model Store
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-shop me-2 text-primary"></i>@Model.Name</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-1"><i class="bi bi-pencil me-1"></i>Изменить</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-1">Адрес</p>
                <p class="fw-semibold mb-0"><i class="bi bi-geo-alt me-1"></i>@Model.Address</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-1">Выручка магазина</p>
                <p class="fw-bold fs-4 text-success mb-0">@Model.Sales.Sum(s => s.TotalAmount).ToString("N2") ₽</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-1">Продаж / Сотрудников</p>
                <p class="fw-bold mb-0">@Model.Sales.Count / @Model.Employees.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white"><i class="bi bi-people me-2"></i>Сотрудники</div>
            <ul class="list-group list-group-flush">
                @foreach (var emp in Model.Employees)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@emp.FullName</span>
                        <span class="text-muted small">@emp.Position</span>
                    </li>
                }
                @if (!Model.Employees.Any())
                {
                    <li class="list-group-item text-muted text-center">Нет сотрудников</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white"><i class="bi bi-clock-history me-2"></i>Последние продажи</div>
            <ul class="list-group list-group-flush">
                @foreach (var sale in Model.Sales.OrderByDescending(s => s.SaleDate).Take(5))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="small">@sale.SaleDate.ToString("dd.MM.yyyy") — @sale.Product?.Name</span>
                        <span class="fw-bold text-success small">@sale.TotalAmount.ToString("N2") ₽</span>
                    </li>
                }
                @if (!Model.Sales.Any())
                {
                    <li class="list-group-item text-muted text-center">Нет продаж</li>
                }
            </ul>
        </div>
    </div>
</div>
