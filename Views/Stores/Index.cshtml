@model IEnumerable<Store>
@{
    ViewData["Title"] = "Магазины";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-shop me-2 text-primary"></i>Магазины</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Добавить</a>
</div>

<div class="row g-3">
    @foreach (var store in Model)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-shop-window me-2 text-primary"></i>@store.Name</h5>
                    <p class="text-muted"><i class="bi bi-geo-alt me-1"></i>@store.Address</p>
                    <div class="d-flex gap-3 text-muted small">
                        <span><i class="bi bi-people me-1"></i>@store.Employees.Count сотр.</span>
                        <span><i class="bi bi-balloon me-1"></i>@store.Products.Count товаров</span>
                        <span class="fw-bold text-success"><i class="bi bi-cash me-1"></i>@store.Sales.Sum(s => s.TotalAmount).ToString("N2") ₽</span>
                    </div>
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@store.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye me-1"></i>Подробнее</a>
                    <a asp-action="Edit" asp-route-id="@store.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil me-1"></i>Изменить</a>
                    <a asp-action="Delete" asp-route-id="@store.Id" class="btn btn-sm btn-outline-danger ms-auto"><i class="bi bi-trash"></i></a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">Магазины не добавлены.</div>
    }
</div>
