@model Employee
@{
    ViewData["Title"] = "Сотрудник";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-person-circle me-2 text-info"></i>@Model.FullName</h5>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Назад</a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">ФИО</dt>
                    <dd class="col-sm-7">@Model.FullName</dd>
                    <dt class="col-sm-5">Должность</dt>
                    <dd class="col-sm-7">@Model.Position</dd>
                    <dt class="col-sm-5">Тип оплаты</dt>
                    <dd class="col-sm-7">
                        @(Model.PaymentType == PaymentType.Salary ? "Оклад" : "Процент от продаж")
                    </dd>
                    <dt class="col-sm-5">Ставка</dt>
                    <dd class="col-sm-7 fw-bold">
                        @Model.Rate.ToString("N2") @(Model.PaymentType == PaymentType.Salary ? "₽/мес." : "%")
                    </dd>
                    <dt class="col-sm-5">Магазин</dt>
                    <dd class="col-sm-7">@(Model.Store?.Name ?? "—")</dd>
                </dl>
                <a asp-controller="Salary" asp-action="Index" class="btn btn-outline-success mt-2">
                    <i class="bi bi-calculator me-1"></i>Рассчитать зарплату
                </a>
            </div>
        </div>
    </div>
</div>
