@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Сотрудники";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>Сотрудники</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Добавить</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ФИО</th>
                    <th>Должность</th>
                    <th>Тип оплаты</th>
                    <th class="text-end">Ставка</th>
                    <th>Магазин</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td class="fw-semibold">@emp.FullName</td>
                        <td>@emp.Position</td>
                        <td>
                            @if (emp.PaymentType == PaymentType.Salary)
                            {
                                <span class="badge bg-info text-dark">Оклад</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">% от продаж</span>
                            }
                        </td>
                        <td class="text-end">
                            @emp.Rate.ToString("N2") @(emp.PaymentType == PaymentType.Salary ? "₽" : "%")
                        </td>
                        <td class="text-muted small">@(emp.Store?.Name ?? "—")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-controller="Salary" asp-action="Index" class="btn btn-sm btn-outline-success" title="Рассчитать зарплату"><i class="bi bi-calculator"></i></a>
                            <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Сотрудники не найдены.</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>
