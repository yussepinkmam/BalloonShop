@model Employee
@{
    ViewData["Title"] = "Добавить сотрудника";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Новый сотрудник</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Фамилия Имя Отчество" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Position" class="form-label fw-semibold"></label>
                        <input asp-for="Position" class="form-control" placeholder="Например: Кассир" />
                        <span asp-validation-for="Position" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentType" class="form-label fw-semibold">Тип оплаты</label>
                        <select asp-for="PaymentType" class="form-select" id="paymentType"
                            asp-items="@Html.GetEnumSelectList<PaymentType>()"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rate" class="form-label fw-semibold">
                            <span id="rateLabel">Ставка</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="Rate" class="form-control" type="number" step="0.01" min="0.01" />
                            <span class="input-group-text" id="rateUnit">₽</span>
                        </div>
                        <span asp-validation-for="Rate" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="StoreId" class="form-label fw-semibold">Магазин</label>
                        <select asp-for="StoreId" class="form-select" asp-items="ViewBag.Stores">
                            <option value="">— Не выбран —</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Сохранить</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const paymentSelect = document.getElementById('paymentType');
    const rateUnit = document.getElementById('rateUnit');
    const rateLabel = document.getElementById('rateLabel');

    paymentSelect.addEventListener('change', function () {
        const isPercent = this.value === '1'; // 1 = Percentage enum value
        rateUnit.textContent = isPercent ? '%' : '₽';
        rateLabel.textContent = isPercent ? 'Процент от продаж' : 'Оклад (руб.)';
    });
    // Trigger on load
    paymentSelect.dispatchEvent(new Event('change'));
</script>
}
