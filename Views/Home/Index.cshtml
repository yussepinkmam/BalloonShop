@{
    ViewData["Title"] = "Главная";
    var totalSales = (decimal)ViewBag.TotalSales;
    var totalItems = (int)ViewBag.TotalItems;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Дашборд</h2>
    <span class="text-muted small">Сводка по всем магазинам</span>
</div>

<!-- Key stats -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Общая сумма продаж</p>
                        <h3 class="fw-bold text-primary mb-0">@totalSales.ToString("N2") ₽</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded p-2">
                        <i class="bi bi-currency-exchange text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Продано шаров</p>
                        <h3 class="fw-bold text-success mb-0">@totalItems шт.</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded p-2">
                        <i class="bi bi-balloon text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Средний чек</p>
                        <h3 class="fw-bold text-warning mb-0">
                            @(totalItems > 0 ? (totalSales / totalItems).ToString("N2") : "0.00") ₽
                        </h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded p-2">
                        <i class="bi bi-graph-up text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Top employees -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-trophy text-warning me-2"></i>Топ-3 сотрудника по продажам
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>ФИО</th>
                            <th class="d-none d-sm-table-cell">Должность</th>
                            <th class="text-end">Сумма</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var top = (dynamic)ViewBag.TopEmployees;
                            int rank = 1;
                            string[] medals = { "🥇", "🥈", "🥉" };
                        }
                        @foreach (var emp in top)
                        {
                            <tr>
                                <td>@medals[rank - 1]</td>
                                <td class="fw-semibold">@emp.FullName</td>
                                <td class="d-none d-sm-table-cell"><span class="text-muted small">@emp.Position</span></td>
                                <td class="text-end fw-bold text-success">@(((decimal)emp.TotalAmount).ToString("N2")) ₽</td>
                            </tr>
                            rank++;
                        }
                        @if (rank == 1)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">Нет данных о продажах</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Store stats -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <i class="bi bi-shop me-2 text-primary"></i>Статистика по магазинам
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Магазин</th>
                            <th class="text-center">Шт.</th>
                            <th class="text-end">Выручка</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var stores = (dynamic)ViewBag.StoreStats;
                        }
                        @foreach (var store in stores)
                        {
                            <tr>
                                <td class="fw-semibold">@store.Name</td>
                                <td class="text-center">@store.TotalItems</td>
                                <td class="text-end text-primary fw-bold">@(((decimal)store.TotalAmount).ToString("N2")) ₽</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick links -->
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <i class="bi bi-lightning me-2 text-warning"></i>Быстрые действия
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a asp-controller="Sales" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Новая продажа
                </a>
                <a asp-controller="Products" asp-action="Create" class="btn btn-outline-primary">
                    <i class="bi bi-balloon me-1"></i>Добавить товар
                </a>
                <a asp-controller="Employees" asp-action="Create" class="btn btn-outline-secondary">
                    <i class="bi bi-person-plus me-1"></i>Новый сотрудник
                </a>
                <a asp-controller="Salary" asp-action="Index" class="btn btn-outline-success">
                    <i class="bi bi-calculator me-1"></i>Рассчитать зарплату
                </a>
            </div>
        </div>
    </div>
</div>
