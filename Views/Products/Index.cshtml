@model IEnumerable<Product>
@{
    ViewData["Title"] = "Товары";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4"><i class="bi bi-balloon me-2 text-primary"></i>Товары (шары)</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Добавить</a>
</div>

<div class="card d-none d-md-block">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Название</th>
                    <th>Тип</th>
                    <th class="text-end">Цена закупки</th>
                    <th class="text-end">Цена продажи</th>
                    <th class="text-center">Остаток</th>
                    <th>Магазин</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            @{
                                var typeBadge = item.Type switch {
                                    BalloonType.Latex => ("bg-success", "Латексный"),
                                    BalloonType.Foil => ("bg-primary", "Фольгированный"),
                                    _ => ("bg-warning text-dark", "С рисунком")
                                };
                            }
                            <span class="badge @typeBadge.Item1">@typeBadge.Item2</span>
                        </td>
                        <td class="text-end">@item.PurchasePrice.ToString("N2")</td>
                        <td class="text-end fw-bold text-success">@item.SalePrice.ToString("N2")</td>
                        <td class="text-center">
                            @if (item.StockQuantity < 10)
                            {
                                <span class="badge bg-danger">@item.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.StockQuantity</span>
                            }
                        </td>
                        <td>@(item.Store?.Name ?? "—")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info py-0 px-1" title="Подробнее"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning py-0 px-1" title="Редактировать"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-0 px-1" title="Удалить"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Товары не найдены. <a asp-action="Create">Добавьте первый товар</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-md-none row g-2">
    @foreach (var item in Model)
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1">@item.Name</h6>
                            <span class="badge @(item.Type switch {
                                BalloonType.Latex => "bg-success",
                                BalloonType.Foil => "bg-primary",
                                _ => "bg-warning text-dark"
                            }) me-2">@(item.Type switch {
                                BalloonType.Latex => "Латексный",
                                BalloonType.Foil => "Фольгированный",
                                _ => "С рисунком"
                            })</span>
                            <span class="text-muted small">@(item.Store?.Name ?? "—")</span>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-success small">@item.SalePrice.ToString("N2") ₽</div>
                            <small class="text-muted">зак. @item.PurchasePrice.ToString("N2")</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div>
                            @if (item.StockQuantity < 10)
                            {
                                <span class="badge bg-danger">Остаток: @item.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Остаток: @item.StockQuantity</span>
                            }
                        </div>
                        <div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info py-0 px-1"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning py-0 px-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-0 px-1"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-4">Товары не найдены. <a asp-action="Create">Добавьте первый товар</a>.</div>
    }
</div>
