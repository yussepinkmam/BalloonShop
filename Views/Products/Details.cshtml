@model Product
@{
    ViewData["Title"] = "Сведения о товаре";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between">
                <h5 class="mb-0"><i class="bi bi-balloon me-2 text-info"></i>@Model.Name</h5>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning me-1">
                        <i class="bi bi-pencil me-1"></i>Изменить
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Назад</a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Название</dt>
                    <dd class="col-sm-7">@Model.Name</dd>
                    <dt class="col-sm-5">Тип</dt>
                    <dd class="col-sm-7">
                        @{
                            var typeName = Model.Type switch {
                                BalloonType.Latex => "Латексный",
                                BalloonType.Foil => "Фольгированный",
                                _ => "С рисунком"
                            };
                        }
                        @typeName
                    </dd>
                    <dt class="col-sm-5">Цена закупки</dt>
                    <dd class="col-sm-7">@Model.PurchasePrice.ToString("N2") ₽</dd>
                    <dt class="col-sm-5">Цена продажи</dt>
                    <dd class="col-sm-7 fw-bold text-success">@Model.SalePrice.ToString("N2") ₽</dd>
                    <dt class="col-sm-5">Маржа</dt>
                    <dd class="col-sm-7 text-primary">@((Model.SalePrice - Model.PurchasePrice).ToString("N2")) ₽
                        (@(((Model.SalePrice - Model.PurchasePrice) / Model.PurchasePrice * 100).ToString("N0"))%)</dd>
                    <dt class="col-sm-5">Остаток на складе</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.StockQuantity < 10 ? "bg-danger" : "bg-secondary") fs-6">
                            @Model.StockQuantity шт.
                        </span>
                    </dd>
                    <dt class="col-sm-5">Магазин</dt>
                    <dd class="col-sm-7">@(Model.Store?.Name ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
