@model Product
@{
    ViewData["Title"] = "Добавить товар";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-balloon me-2 text-primary"></i>Новый товар</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Например: Шар красный латексный 12&quot;" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-semibold">Тип шара</label>
                        <select asp-for="Type" class="form-select"
                            asp-items="@Html.GetEnumSelectList<BalloonType>()"></select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PurchasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" min="0.01" />
                                <span class="input-group-text">₽</span>
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0.01" />
                                <span class="input-group-text">₽</span>
                            </div>
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="StoreId" class="form-label fw-semibold">Магазин</label>
                        <select asp-for="StoreId" class="form-select" asp-items="ViewBag.Stores">
                            <option value="">— Не выбран —</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Сохранить</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
