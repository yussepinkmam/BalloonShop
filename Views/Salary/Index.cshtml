@model SalaryRequestModel
@{
    ViewData["Title"] = "Расчёт зарплаты";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-4"><i class="bi bi-calculator me-2 text-primary"></i>Расчёт зарплаты</h2>

        <div class="card">
            <div class="card-body">
                <form asp-action="Calculate" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="EmployeeId" class="form-label fw-semibold">Сотрудник</label>
                        <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
                            <option value="0">— Выберите сотрудника —</option>
                        </select>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DateFrom" class="form-label fw-semibold">Период с</label>
                            <input asp-for="DateFrom" type="date" class="form-control" />
                            <span asp-validation-for="DateFrom" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateTo" class="form-label fw-semibold">по</label>
                            <input asp-for="DateTo" type="date" class="form-control" />
                            <span asp-validation-for="DateTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-calculator me-2"></i>Рассчитать зарплату
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
