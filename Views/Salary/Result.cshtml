@model SalaryCalculation
@{
    ViewData["Title"] = "Расчёт зарплаты";
    var request = (SalaryRequestModel)ViewBag.Request;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-calculator me-2 text-primary"></i>Расчёт зарплаты</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Новый расчёт
    </a>
</div>

<!-- Summary card -->
<div class="card mb-4 border-success">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>@Model.Employee?.FullName — @Model.Employee?.Position</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <p class="text-muted small mb-1">Период</p>
                <p class="fw-semibold mb-0">
                    @Model.DateFrom.ToString("dd.MM.yyyy") — @Model.DateTo.ToString("dd.MM.yyyy")
                </p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">Продаж за период</p>
                <p class="fw-semibold mb-0">@Model.Sales.Count (шт.: @Model.TotalItemsSold)</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">Сумма продаж</p>
                <p class="fw-semibold mb-0">@Model.TotalSalesAmount.ToString("N2") ₽</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">Начислено зарплаты</p>
                <p class="fs-4 fw-bold text-success mb-0">@Model.CalculatedSalary.ToString("N2") ₽</p>
            </div>
        </div>

        <hr />
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Формула расчёта:</strong> @Model.PaymentDescription
        </div>
    </div>
</div>

<!-- Sales table -->
<div class="card">
    <div class="card-header bg-white">
        <i class="bi bi-list-ul me-2"></i>Продажи за период
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Дата</th>
                    <th>Товар</th>
                    <th class="text-center">Кол-во</th>
                    <th class="text-end">Сумма</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td>@sale.SaleDate.ToString("dd.MM.yyyy")</td>
                        <td>@sale.Product?.Name</td>
                        <td class="text-center">@sale.Quantity шт.</td>
                        <td class="text-end text-success fw-bold">@sale.TotalAmount.ToString("N2") ₽</td>
                    </tr>
                }
                @if (!Model.Sales.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">За выбранный период продаж не найдено.</td></tr>
                }
            </tbody>
            @if (Model.Sales.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end">Итого:</td>
                        <td class="text-end text-success">@Model.TotalSalesAmount.ToString("N2") ₽</td>
                    </tr>
                </tfoot>
            }
        </table>
        </div>
    </div>
</div>

<!-- Recalculate form -->
<div class="card mt-3">
    <div class="card-body">
        <h6 class="mb-3"><i class="bi bi-arrow-repeat me-2 text-primary"></i>Пересчитать</h6>
        <form asp-action="Calculate" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="EmployeeId" value="@Model.Employee?.Id" />
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Период с</label>
                <input type="date" name="DateFrom" class="form-control" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">по</label>
                <input type="date" name="DateTo" class="form-control" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-arrow-repeat me-1"></i>Пересчитать
                </button>
            </div>
        </form>
    </div>
</div>
