@model SalaryCalculation
@{
    ViewData["Title"] = "Расчёт зарплаты";
    var request = (SalaryRequestModel)ViewBag.Request;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 fs-4"><i class="bi bi-calculator me-2 text-primary"></i>Расчёт зарплаты</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Назад
    </a>
</div>

<div class="card mb-4 border-success">
    <div class="card-header bg-success text-white py-2">
        <h6 class="mb-0"><i class="bi bi-person-circle me-2"></i>@Model.Employee?.FullName — @Model.Employee?.Position</h6>
    </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <p class="text-muted small mb-0">Период</p>
                <p class="fw-semibold small mb-0">@Model.DateFrom.ToString("dd.MM") — @Model.DateTo.ToString("dd.MM")</p>
            </div>
            <div class="col-6 col-md-3">
                <p class="text-muted small mb-0">Продаж</p>
                <p class="fw-semibold small mb-0">@Model.TotalItemsSold шт.</p>
            </div>
            <div class="col-6 col-md-3">
                <p class="text-muted small mb-0">Сумма продаж</p>
                <p class="fw-semibold small mb-0">@Model.TotalSalesAmount.ToString("N2") ₽</p>
            </div>
            <div class="col-6 col-md-3">
                <p class="text-muted small mb-0">Начислено</p>
                <p class="fs-5 fw-bold text-success mb-0">@Model.CalculatedSalary.ToString("N2") ₽</p>
            </div>
        </div>
        <hr class="my-2" />
        <div class="alert alert-info py-2 mb-0 small">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Формула:</strong> @Model.PaymentDescription
        </div>
    </div>
</div>

<div class="card d-none d-md-block">
    <div class="card-header bg-white py-2">
        <h6 class="mb-0"><i class="bi bi-list-ul me-2"></i>Продажи за период</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Дата</th>
                    <th>Товар</th>
                    <th class="text-center">Кол-во</th>
                    <th class="text-end">Сумма</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td class="small">@sale.SaleDate.ToString("dd.MM")</td>
                        <td>@sale.Product?.Name</td>
                        <td class="text-center">@sale.Quantity</td>
                        <td class="text-end text-success fw-bold">@sale.TotalAmount.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Sales.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">За выбранный период продаж не найдено.</td></tr>
                }
            </tbody>
            @if (Model.Sales.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end">Итого:</td>
                        <td class="text-end text-success">@Model.TotalSalesAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<div class="d-md-none">
    <div class="card">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0"><i class="bi bi-list-ul me-2"></i>Продажи</h6>
        </div>
        <div class="card-body py-2 px-3">
            <div class="row g-2">
                @foreach (var sale in Model.Sales)
                {
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="small text-muted">@sale.SaleDate.ToString("dd.MM")</span>
                                <span class="ms-2">@sale.Product?.Name</span>
                            </div>
                            <div>
                                <span class="badge bg-secondary me-2">×@sale.Quantity</span>
                                <span class="fw-bold text-success">@sale.TotalAmount.ToString("N2")</span>
                            </div>
                        </div>
                        @if (sale != Model.Sales.Last())
                        {
                            <hr class="my-1" />
                        }
                    </div>
                }
                @if (!Model.Sales.Any())
                {
                    <div class="col-12 text-center text-muted py-4">Продаж не найдено.</div>
                }
            </div>
            @if (Model.Sales.Any())
            {
                <hr class="my-2" />
                <div class="d-flex justify-content-between fw-bold">
                    <span>Итого:</span>
                    <span class="text-success">@Model.TotalSalesAmount.ToString("N2") ₽</span>
                </div>
            }
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body py-2">
        <h6 class="mb-2"><i class="bi bi-arrow-repeat me-2 text-primary"></i>Пересчитать</h6>
        <form asp-action="Calculate" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="EmployeeId" value="@Model.Employee?.Id" />
            <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold mb-0">С</label>
                <input type="date" name="DateFrom" class="form-control form-control-sm" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold mb-0">По</label>
                <input type="date" name="DateTo" class="form-control form-control-sm" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-4">
                <button type="submit" class="btn btn-primary btn-sm w-100 mt-1">
                    <i class="bi bi-arrow-repeat me-1"></i>Пересчитать
                </button>
            </div>
        </form>
    </div>
</div>
