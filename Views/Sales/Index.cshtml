@model IEnumerable<Sale>
@{
    ViewData["Title"] = "Продажи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4 fs-md-3"><i class="bi bi-receipt me-2 text-primary"></i>Продажи</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Новая</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Дата</th>
                    <th class="d-none d-sm-table-cell">Товар</th>
                    <th class="text-center">Кол-во</th>
                    <th class="d-none d-sm-table-cell">Кассир</th>
                    <th class="d-none d-md-table-cell">Магазин</th>
                    <th class="text-end">Сумма</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="small">@item.SaleDate.ToString("dd.MM")</td>
                        <td class="d-none d-sm-table-cell">@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="d-none d-sm-table-cell">@item.Employee?.FullName</td>
                        <td class="d-none d-md-table-cell text-muted small">@(item.Store?.Name ?? "—")</td>
                        <td class="text-end fw-bold text-success small">@item.TotalAmount.ToString("N2")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info py-0 px-1"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning py-0 px-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-0 px-1"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Нет записей о продажах.</td></tr>
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="text-end d-none d-sm-table-cell">Итого:</td>
                        <td class="text-end d-sm-none">Итого:</td>
                        <td class="text-end text-success">@Model.Sum(s => s.TotalAmount).ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
